APP_ENV=local
APP_ORIGIN=http://127.0.0.1:4310
# For authenticated staging only. Comma-separated exact HTTPS origins for aliases.
APP_ADDITIONAL_ORIGINS=
HOST=127.0.0.1
PORT=4310
# Only local disposable development; staging refuses synthetic identity.
LOCAL_TEST_IDENTITY=false
# Use a dedicated flockletter_ database and restricted runtime role.
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Migration authority is separate and must never be in the runtime service.
# MIGRATION_DATABASE_URL=
# RUNTIME_DATABASE_ROLE=flockletter_runtime

# Optional staging subscriber intake. Set independently for Flockletter. Off by default.
FLOCKLETTER_CONFIRMATION_MODE=off
# FLOCKLETTER_INTAKE_WORKSPACE=
# FLOCKLETTER_INTAKE_BRAND=
# FLOCKLETTER_INTAKE_SOURCE_DOMAIN=
# FLOCKLETTER_CONFIRMATION_SIGNING_KEY=
# FLOCKLETTER_CONFIRMATION_RECIPIENTS=
# FLOCKLETTER_CONFIRMATION_FROM=
# FLOCKLETTER_CONFIRMATION_FEEDBACK_SECRET=
# FLOCKLETTER_CONFIRMATION_LIVE_APPROVED=false
# Worker only: FLOCKLETTER_CONFIRMATION_RESEND_KEY=
