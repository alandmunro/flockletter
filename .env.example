APP_ENV=local
APP_ORIGIN=http://127.0.0.1:4310
# For authenticated staging only. Comma-separated exact HTTPS origins for aliases.
APP_ADDITIONAL_ORIGINS=
HOST=127.0.0.1
PORT=4310
# Only local disposable development; staging refuses synthetic identity.
LOCAL_TEST_IDENTITY=false
# Use a dedicated flockletter_ database and restricted runtime role.
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Migration authority is separate and must never be in the runtime service.
# MIGRATION_DATABASE_URL=
# RUNTIME_DATABASE_ROLE=flockletter_runtime

# Optional staging subscriber intake. Set independently for Flockletter. Off by default.
FLOCKLETTER_CONFIRMATION_MODE=off
# FLOCKLETTER_INTAKE_WORKSPACE=
# FLOCKLETTER_INTAKE_BRAND=
# FLOCKLETTER_INTAKE_SOURCE_DOMAIN=
# FLOCKLETTER_CONFIRMATION_SIGNING_KEY=
# FLOCKLETTER_CONFIRMATION_RECIPIENTS=
# FLOCKLETTER_CONFIRMATION_FROM=
# FLOCKLETTER_CONFIRMATION_FEEDBACK_SECRET=
# FLOCKLETTER_CONFIRMATION_LIVE_APPROVED=false
# Worker only: FLOCKLETTER_CONFIRMATION_RESEND_KEY=

# Recipient marketing opt-out. Retain issued bindings on the canonical HTTPS origin even while sending is off.
# FLOCKLETTER_UNSUBSCRIBE_BINDINGS=[{"workspaceId":"org_example","brandId":"00000000-0000-4000-8000-000000000001"}]
# Issuing worker only: set a dedicated random 32-byte hex value. The redemption service only needs the bindings.
# FLOCKLETTER_UNSUBSCRIBE_SIGNING_KEY=

# Optional periodic captured campaigns. Both identify a single staging workspace/brand.
# FLOCKLETTER_CAPTURE_WORKSPACE=
# FLOCKLETTER_CAPTURE_BRAND=
# FLOCKLETTER_COMPLIMENTARY_WORKSPACE=

# Dedicated Stripe sandbox only. Never use a live key or another app’s prices.
FLOCKLETTER_BILLING_MODE=off
# FLOCKLETTER_STRIPE_TEST_ACCOUNT=
# FLOCKLETTER_STRIPE_TEST_KEY=
# FLOCKLETTER_STRIPE_TEST_WEBHOOK=
# FLOCKLETTER_STRIPE_CARD_CONFIG=
# FLOCKLETTER_STRIPE_STARTER_PRICE=
# FLOCKLETTER_STRIPE_GROWTH_PRICE=
# FLOCKLETTER_STRIPE_PRO_PRICE=

# Optional SES mailbox simulator. Absent by default. No customer addresses allowed.
# Requires an explicit brand/worker binding, current domain ownership and protected dedicated credentials.
# See docs/implementation/CAMPAIGN_FEEDBACK.md for the required JSON fields and permissions.
# FLOCKLETTER_SES_SIMULATOR_BINDING=
# Accepts one brand binding or an array. Set paused on a binding to hold that workspace.
# See docs/implementation/DELIVERY_READINESS.md for the fields and read-only inspection permissions.
# FLOCKLETTER_SES_ACCESS_KEY_ID=
# FLOCKLETTER_SES_SECRET_ACCESS_KEY=
# FLOCKLETTER_SES_SESSION_TOKEN=

# Opt in during both build and runtime to a private Listmonk rehearsal for the bound staging brand.
# FLOCKLETTER_PRIVATE_ENGINE=embedded

# Clerk member invitation pilot. Leave off until the exact staging workspace and recipients are approved.
# FLOCKLETTER_TEAM_INVITES=off
# FLOCKLETTER_TEAM_INVITE_WORKSPACE=
# FLOCKLETTER_TEAM_INVITE_RECIPIENTS=
