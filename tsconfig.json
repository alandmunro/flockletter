{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"], "noEmit": true
  },
  "include": ["src", "scripts", "tests", "vite.config.ts", "vitest.config.ts"]
}
