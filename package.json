{
  "name": "flockletter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "confirmation:worker": "node dist/server/server/confirmation/main.js",
    "mcp": "tsx src/mcp/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "api:generate": "node --import tsx scripts/generate-api.ts",
    "support:draft": "node --import tsx scripts/support-draft.ts",
    "audience:verify": "node --import tsx scripts/prove-audience.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.27.0",
    "@clerk/react": "6.18.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "standardwebhooks": "1.1.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "playwright-core": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
