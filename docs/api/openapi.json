          },
          "404": {
            "description": "Unavailable brand."
          },
          "429": {
            "description": "Probe rate limit."
          },
          "503": {
            "description": "Brand, source or confirmation worker is unavailable."
          }
        }
      },
      "post": {
        "operationId": "subscriber_signup",
        "summary": "Accept an attested first-party signup for one configured brand.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "subscriber:signup",
        "parameters": [
          {
            "in": "path",
            "name": "brandId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "purpose": {
                    "type": "string",
                    "const": "ffa_product_marketing"
                  },
                  "consentAffirmed": {
                    "type": "boolean",
                    "const": true
                  },
                  "consentVersion": {
                    "type": "string",
                    "const": "ffa-newsletter-v1"
                  },
                  "consentText": {
                    "type": "string",
                    "const": "Email me product launches, promotions, and occasional updates from Frosty Flamingo Apparel. I can unsubscribe anytime."
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "storefront-footer",
                      "storefront-homepage"
                    ]
                  },
                  "sourceDomain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  }
                },
                "required": [
                  "email",
                  "purpose",
                  "consentAffirmed",
                  "consentVersion",
                  "consentText",
                  "source",
                  "sourceDomain"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted without disclosing subscriber status.",
            "content": {
              "application/json": {
                "example": {
                  "status": "pending_confirmation",
                  "message": "If this address can be subscribed, check your inbox for a confirmation email."
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON."
          },
          "401": {
            "description": "Invalid or expired credential."
          },
          "403": {
            "description": "Server client or scope required."
          },
          "404": {
            "description": "Unavailable brand."
          },
          "409": {
            "description": "Operation key reused with different input."
          },
          "413": {
            "description": "Body exceeds 8 KiB."
          },
          "415": {
            "description": "Unsupported content type."
          },
          "422": {
            "description": "Invalid consent or input."
          },
          "429": {
            "description": "Rate limited."
          },
          "503": {
            "description": "Intake or its confirmation worker is unavailable."
          }
        }
      }
    }
  },
